# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

*.js
!src/storage/y-indexeddb.js
!__tests__/jest.setup.js
# jest.config.js predates the *.js rule and is tracked; its live-harness
# sibling needs an explicit exception or it would silently never be committed.
!jest.live.config.js
# jest.config.js попадает под *.js и держится в индексе только по инерции:
# он добавлен до появления правила. Без явного исключения любой свежий срез
# по неигнорируемым путям теряет его молча (измерено: 307 файлов против 308).
!jest.config.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store
vaults/

# IDE & Tools (not for OSS)
.cursor/
.claude/
CLAUDE.md

# Internal documentation (not for OSS)
dev-docs/
